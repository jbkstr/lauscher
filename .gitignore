# macOS
.DS_Store
._*

# Rohes Sample-Quellmaterial (für den Browser nicht nötig)
daw-sampling/

# Audio-Samples liegen im privaten Repo jbkstr/lauscher-samples (scripts/samples.sh pull|push).
# Öffentlich bleiben nur die Maskottchen-Grafiken.
samples/*
!samples/mascot-bundle.js
!samples/mascot-metal-bundle.js

# Mobile-Bundle enthält alle Samples inline → nur lokal bauen (scripts/build-mobile-bundle.py)
lauscher-mobile.html

# Rohbilder aus Gemini (groß, nur Ausgangsmaterial; eingebaut wird über samples/mascot-bundle.js)
design/gemini-output/

# Editoren & Tools
.vscode/
.idea/
*.swp
.claude/settings.local.json

# Python
__pycache__/
*.pyc

# Android-Builds & Signaturschlüssel nie committen (APK nur als GitHub-Release-Anhang)
*.apk
*.aab
*.jks
*.keystore
keystore.properties

# Lokale Screenshot-Datenbank (generiert via scripts/capture-screenshots.py)
screenshots/

# Interne Doku (Audit-Berichte, Konzepte, Ideen) bleibt nur lokal im Haupt-Checkout
docs/
